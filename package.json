{
	"name": "webserf",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:cloudflare": "ADAPTER=cloudflare vite build",
		"deploy:cloudflare": "npm run build:cloudflare && npx wrangler deploy",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@iconify-json/material-symbols-light": "^1.2.89",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"idb": "^8.0.3",
		"libadlmidi-js": "^2.2.0"
	}
}